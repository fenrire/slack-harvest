# Slack User Token (xoxp-)
# 방법 1: Windows Credential Manager 사용 (권장)
SLACK_CM_SERVICE=your-app:slack
SLACK_CM_USERNAME=user-token
# 방법 2: 직접 환경변수 (배치/CI 환경)
# SLACK_TOKEN=xoxp-your-user-token-here

# Google Gemini API Key (스레드 요약용, 선택)
# 방법 1: Windows Credential Manager 사용 (권장)
GEMINI_CM_SERVICE=your-app:google-ai-studio
GEMINI_CM_USERNAME=gemini
# 방법 2: 직접 환경변수
# GEMINI_API_KEY=your-gemini-api-key-here

# 출력 디렉토리 (기본: ~/Documents/SlackArchive)
# HARVEST_OUTPUT_DIR=~/Documents/SlackArchive

# 수집 대상 채널 목록 파일 (기본: ./channels.txt)
# HARVEST_CHANNELS_FILE=channels.txt

# 배치 작업 로그 파일 경로 (미설정 시 로그 비활성)
# HARVEST_LOG_FILE=C:/Users/yourname/Documents/ops.log

# work-nexus 연동 (선택, 미설정 시 NexusEvent 내보내기 비활성)
# NEXUS_OUTBOX_DIR=~/Documents/Projects/work-nexus/data/outbox

# Windows 터미널 한글 깨짐 방지
PYTHONUTF8=1
