# Bot Token (xoxb-): 초대된 public 채널만 접근
SLACK_BOT_TOKEN=xoxb-your-token-here

# User Token (xoxp-): 내가 멤버인 모든 채널 + Private + DM 자동 접근 (권장)
# Slack App → OAuth & Permissions → User Token Scopes에서 발급
# 필요 스코프: channels:history, channels:read, groups:history, groups:read,
#             im:history, im:read, mpim:history, mpim:read, users:read, files:read
# SLACK_USER_TOKEN=xoxp-your-user-token-here

# Optional: sync specific channels only (comma-separated)
# HARVEST_CHANNELS_INCLUDE=general,engineering,product
# HARVEST_CHANNELS_EXCLUDE=random,social

# Optional: custom paths
# HARVEST_DB_PATH=data/slack_harvest.db
# HARVEST_EXPORT_DIR=export
