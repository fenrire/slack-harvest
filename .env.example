# 크레덴셜 식별자는 config.yaml에서 관리 (WCM 우선)
# 환경변수 폴백: WCM 없는 환경(macOS/Linux/CI)에서 직접 설정

# Slack User Token (xoxp-) — WCM 없는 환경 폴백
# SLACK_USER_TOKEN=xoxp-your-user-token-here

# Google Gemini API Key (스레드 요약용, 선택) — WCM 없는 환경 폴백
# GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here

# 출력 디렉토리 (기본: ~/Documents/SlackArchive)
# HARVEST_OUTPUT_DIR=~/Documents/SlackArchive

# 수집 대상 채널 목록 파일 (기본: ./channels.txt)
# HARVEST_CHANNELS_FILE=channels.txt

# 배치 작업 로그 파일 경로 (미설정 시 로그 비활성)
# HARVEST_LOG_FILE=C:/Users/yourname/Documents/ops.log

# work-nexus 연동 (선택, 미설정 시 NexusEvent 내보내기 비활성)
# NEXUS_OUTBOX_DIR=~/Documents/Projects/work-nexus/data/outbox

# Windows 터미널 한글 깨짐 방지
PYTHONUTF8=1
